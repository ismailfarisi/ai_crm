# ─── Docker / Postgres ────────────────────────────────────────────────────────
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_dev_password
POSTGRES_DB=crm
POSTGRES_PORT=5433
REDIS_PORT=6380
REDIS_HOST=localhost

# Production check-in window in UTC (end hour is exclusive; defaults to 07:00-19:00).
PRODUCTION_CHECK_IN_START_HOUR_UTC=7
PRODUCTION_CHECK_IN_END_HOUR_UTC=19

# API connection uses a separate non-superuser role for RLS enforcement.
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=crm_app
DB_PASSWORD=crm_app_dev_password
DB_NAME=crm
DB_ADMIN_USERNAME=crm
DB_ADMIN_PASSWORD=crm_dev_password

# Copy this file to `.env` at the repo root (used by docker compose),
# and to `apps/api/.env` (used by the NestJS app).
