# ─── Docker / Postgres ────────────────────────────────────────────────────────
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_dev_password
POSTGRES_DB=crm
POSTGRES_PORT=5433
REDIS_PORT=6380
REDIS_HOST=localhost

# Production check-in window in UTC (end hour is exclusive; defaults to 07:00-19:00).
PRODUCTION_CHECK_IN_START_HOUR_UTC=7
PRODUCTION_CHECK_IN_END_HOUR_UTC=19

# API connection uses a separate non-superuser role for RLS enforcement.
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=crm_app
DB_PASSWORD=crm_app_dev_password
DB_NAME=crm
DB_ADMIN_USERNAME=crm
DB_ADMIN_PASSWORD=crm_dev_password

# Connection tuning (see apps/api/.env.example for what each one does).
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

# Payroll bank-detail encryption key (32 bytes, base64; `openssl rand -base64 32`).
# Required in production — the API refuses to boot without it.
PAYROLL_DATA_KEY=

# Durable CRM event delivery (crm_event_outbox).
EVENT_OUTBOX_DISPATCHER=true
EVENT_OUTBOX_POLL_MS=1000
EVENT_OUTBOX_BATCH_SIZE=50
EVENT_OUTBOX_MAX_ATTEMPTS=10

# Staging only: nightly pg_dump sidecar in docker-compose.staging.yml.
# BACKUP_DIR is a host path; BACKUP_RETENTION_DAYS prunes older dumps.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_HOUR_UTC=2

# Copy this file to `.env` at the repo root (used by docker compose),
# and to `apps/api/.env` (used by the NestJS app).
