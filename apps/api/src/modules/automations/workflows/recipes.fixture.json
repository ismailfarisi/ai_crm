        "customerPhone": "+971501234567",
        "totalAmount": 18375,
        "currency": "AED",
        "sentTo": "orders@alnoorbakery.ae",
        "validUntil": "2026-12-04T00:00:00.000Z"
      }
    },
    "nodes": [
      {
        "id": "trigger-1",
        "type": "crmEventTrigger",
        "position": {
          "x": 100,
          "y": 100
        },
        "data": {
          "label": "Quote sent",
          "config": {
            "event": "quote.sent"
          }
        }
      },
      {
        "id": "delay-1",
        "type": "delayNode",
        "position": {
          "x": 100,
          "y": 250
        },
        "data": {
          "label": "Wait 3 days",
          "config": {
            "durationMs": "3 days"
          }
        }
      },
      {
        "id": "lookup-1",
        "type": "crmMutateNode",
        "position": {
          "x": 100,
          "y": 400
        },
        "data": {
          "label": "Look up the quote",
          "config": {
            "entity": "quote",
            "action": "get",
            "recordId": "{{ $trigger.payload.quoteId }}"
          }
        }
      },
      {
        "id": "check-1",
        "type": "conditionNode",
        "position": {
          "x": 100,
          "y": 550
        },
        "data": {
          "label": "Still waiting on the customer?",
          "config": {
            "condition": "$json.awaitingCustomer == true"
          }
        }
      },
      {
        "id": "email-1",
        "type": "sendEmailNode",
        "position": {
          "x": 100,
          "y": 790
        },
        "data": {
          "label": "Follow up",
          "config": {
            "to": "{{ $trigger.payload.customerEmail }}",
            "subject": "Your quote {{ $trigger.payload.quoteNumber }}",
            "body": "Hello {{ $trigger.payload.customerName }},\n\nWe sent you quote {{ $trigger.payload.quoteNumber }} ({{ $trigger.payload.title }}) a few days ago. Do you have any questions, or would you like us to change anything?\n\nYou can accept it from the link in our earlier email, or just reply to this one.\n\nThank you"
          }
        }
      }
    ],
    "edges": [
      {
        "id": "e-trigger-1-delay-1",
        "source": "trigger-1",
        "target": "delay-1"
      },
      {
        "id": "e-delay-1-lookup-1",
        "source": "delay-1",
        "target": "lookup-1"
      },
      {
        "id": "e-lookup-1-check-1",
        "source": "lookup-1",
        "target": "check-1"
      },
      {
        "id": "e-check-1-email-1",
        "source": "check-1",
        "target": "email-1",
        "sourceHandle": "true"
      }
    ]
  },
