NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# ─── Database ─────────────────────────────────────────────────────────────────
# Matches the host port published by docker-compose.yml.
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=crm
DB_PASSWORD=crm_dev_password
DB_NAME=crm
# Auto-creates tables from the entities. Development only — the schema is now
# owned by migrations. Set up a fresh dev DB with: pnpm db:reset && pnpm migration:run
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate real ones with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev_only_access_secret_change_me_at_least_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev_only_refresh_secret_change_me_at_least_32_chars
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# ─── Cookies / CORS ───────────────────────────────────────────────────────────
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.yourdomain.com
# Comma-separated. 3002 is included because `next dev` falls back to it when
# something else already holds port 3000 — without it the browser's credentialed
# requests would fail CORS and every API call would look like a login problem.
WEB_ORIGIN=http://localhost:3000,http://localhost:3002

# ─── Webhooks ─────────────────────────────────────────────────────────────────
# Public URL this API is reachable at — used to build the URLs handed to
# providers that register webhooks via API (e.g. Telegram's setWebhook).
# Point this at your tunnel (ngrok, etc.) in local dev, or your real API
# domain in production. Left unset, it falls back to localhost, which is
# fine for display but unreachable from Telegram's servers.
# PUBLIC_API_URL=https://your-tunnel.ngrok-free.app/api/v1

# ─── Rate limiting ────────────────────────────────────────────────────────────
# Proxies in front of the API: 1 for a single reverse proxy (the default),
# 2 when a CDN such as Cloudflare sits in front of it. Getting this wrong
# makes every visitor share one rate-limit bucket.
TRUST_PROXY_HOPS=1

THROTTLE_TTL=60000
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10

# ─── Mail (invites) ───────────────────────────────────────────────────────────
# console = logs the invite link to the API console (dev default)
# ses     = AWS SES v2; credentials come from the SDK's default chain
#           (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, IAM role, ...)
MAIL_PROVIDER=console
MAIL_FROM=Relay CRM <no-reply@relay.local>
# MAIL_REGION=us-east-1

# ─── File attachments ───────────────────────────────────────────────
# local = files on the API's own disk (dev default; mount a volume in Docker)
# s3    = an S3 bucket; credentials come from the SDK's default chain, and
#         downloads are presigned by S3 so the bytes never pass through the API
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
# STORAGE_S3_BUCKET=relay-attachments
# STORAGE_S3_REGION=eu-west-2
# How long a download link stays valid, in seconds.
STORAGE_URL_TTL=300

# ─── AI (receipt scanning, future: automations/quotes) ────────────────────────
# anthropic = Claude (only provider implemented). Leave AI_ANTHROPIC_API_KEY unset
# to run with AI features gracefully disabled — e.g. receipt scan falls back to
# manual entry, nothing else breaks.
AI_PROVIDER=anthropic
# AI_ANTHROPIC_API_KEY=sk-ant-...
AI_ANTHROPIC_MODEL=claude-sonnet-5
